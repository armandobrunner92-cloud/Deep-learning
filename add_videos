   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "def ui_procesar(rutas):\n",
    "    if not rutas:\n",
    "        return pd.DataFrame(), \"Sube uno o más videos.\", None\n",
    "    if isinstance(rutas, str):\n",
    "        rutas = [rutas]\n",
    "    filas, errores, ultima = [], [], None\n",
    "    for r in rutas:\n",
    "        try:\n",
    "            res = procesar_video(r)\n",
    "            filas.append({\"Archivo\": res[\"archivo\"], \"Duración (s)\": res[\"duracion\"], \"Resolución\": res[\"resolucion\"],\n",
    "                          \"Cambios de escena\": res[\"cambios\"], \"Idioma\": res[\"idioma\"],\n",
    "                          \"Palabras clave\": res[\"palabras_clave\"], \"Resumen\": res[\"resumen\"]})\n",
    "            ultima = res[\"miniatura\"] or ultima\n",
    "        except Exception as e:\n",
    "            errores.append(f\"{os.path.basename(r)}: {e}\")\n",
    "    estado = f\"Videos procesados y guardados: {len(filas)} de {len(rutas)}.\"\n",
    "    if errores:\n",
    "        estado += \"\\nErrores:\\n\" + \"\\n\".join(errores)\n",
    "    return pd.DataFrame(filas), estado, ultima\n",
    "\n",
    "def ver_tablas():\n",
    "    with conectar() as con:\n",
    "        v = pd.read_sql_query(\"SELECT * FROM videos ORDER BY id DESC\", con)\n",
    "        a = pd.read_sql_query(\"SELECT * FROM analisis_videos ORDER BY id DESC\", con)\n",
    "    return v, a\n",
    "\n",
    "with gr.Blocks(title=\"Procesamiento de videos\") as demo:\n",
    "    gr.Markdown(\"# Procesamiento de videos: resumen y análisis\")\n",
    "    with gr.Tabs():\n",
    "        with gr.TabItem(\"Procesar video\"):\n",
    "            archivos = gr.File(file_count=\"multiple\", file_types=[\".mp4\", \".mov\", \".avi\", \".mkv\", \".webm\"],\n",
    "                               type=\"filepath\", label=\"Videos\")\n",
    "            btn = gr.Button(\"Procesar y guardar\", variant=\"primary\")\n",
    "            estado = gr.Textbox(label=\"Estado\", lines=3)\n",
    "            tabla = gr.Dataframe(label=\"Resultados\")\n",
    "            mini = gr.Image(label=\"Miniatura (último video)\", type=\"filepath\")\n",
    "            btn.click(ui_procesar, archivos, [tabla, estado, mini])\n",
    "        with gr.TabItem(\"Base de datos\"):\n",
    "            b = gr.Button(\"Actualizar tablas\")\n",
    "            t_v = gr.Dataframe(label=\"Tabla: videos\")\n",
    "            t_a = gr.Dataframe(label=\"Tabla: analisis_videos\")\n",
    "            b.click(ver_tablas, None, [t_v, t_a])\n",
    "\n",
    "demo.launch(share=True, debug=True)"
