   "source": [
    "## a. Base de datos y tabla de videos"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "DB = \"videos.db\"\n",
    "\n",
    "def conectar():\n",
    "    return sqlite3.connect(DB)\n",
    "\n",
    "def crear_tablas():\n",
    "    with conectar() as con:\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS videos (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            nombre_archivo TEXT NOT NULL,\n",
    "            resumen TEXT)''')\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS analisis_videos (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            video_id INTEGER REFERENCES videos(id),\n",
    "            fecha TEXT,\n",
    "            duracion_seg REAL,\n",
    "            fps REAL,\n",
    "            ancho INTEGER,\n",
    "            alto INTEGER,\n",
    "            brillo_promedio REAL,\n",
    "            cambios_escena INTEGER,\n",
    "            idioma TEXT,\n",
    "            transcripcion TEXT,\n",
    "            palabras_clave TEXT,\n",
    "            miniatura TEXT)''')\n",
    "\n",
    "crear_tablas()\n",
    "print(\"Tablas creadas: videos y analisis_videos\")"
   ]
