   "source": [
    "def analizar_imagenes(ruta, nombre):\n",
    "    cap = cv2.VideoCapture(ruta)\n",
    "    if not cap.isOpened():\n",
    "        raise ValueError(\"No se pudo abrir el video.\")\n",
    "    fps = cap.get(cv2.CAP_PROP_FPS) or 0\n",
    "    ancho = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))\n",
    "    alto = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))\n",
    "    paso = max(int(round(fps)), 1)            # un fotograma muestreado por segundo\n",
    "    brillos, cambios, previo, miniatura, idx = [], 0, None, None, 0\n",
    "    while cap.grab():\n",
    "        if idx % paso == 0:\n",
    "            ok, frame = cap.retrieve()\n",
    "            if ok:\n",
    "                gris = cv2.resize(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY), (64, 36)).astype(float)\n",
    "                brillos.append(float(gris.mean()))\n",
    "                if previo is not None and np.abs(gris - previo).mean() > 30:\n",
    "                    cambios += 1\n",
    "                previo = gris\n",
    "                if miniatura is None:\n",
    "                    miniatura = frame\n",
    "        idx += 1\n",
    "    cap.release()\n",
    "    if idx == 0:\n",
    "        raise ValueError(\"El video no tiene fotogramas.\")\n",
    "    ruta_min = \"\"\n",
    "    if miniatura is not None:\n",
    "        ruta_min = os.path.join(\"miniaturas\", os.path.splitext(nombre)[0] + \".jpg\")\n",
    "        cv2.imwrite(ruta_min, miniatura)\n",
    "    duracion = round(idx / fps, 2) if fps else 0.0\n",
    "    return {\"duracion\": duracion, \"fps\": round(fps, 2), \"ancho\": ancho, \"alto\": alto,\n",
    "            \"brillo\": round(float(np.mean(brillos)), 1) if brillos else 0.0,\n",
    "            \"cambios\": cambios, \"miniatura\": ruta_min}\n",
    "\n",
    "def procesar_video(ruta):\n",
    "    nombre = os.path.basename(ruta)\n",
    "    vis = analizar_imagenes(ruta, nombre)\n",
    "    try:\n",
    "        texto, idioma = transcribir_audio(ruta)\n",
    "    except Exception:\n",
    "        texto, idioma = \"\", \"\"                 # video sin pista de audio\n",
    "    if texto:\n",
    "        resumen = resumir(texto)\n",
    "        claves = \", \".join(p for p, _ in Counter(palabras_utiles(texto)).most_common(8))\n",
    "    else:\n",
    "        resumen, claves = \"No se detectó voz en el video.\", \"\"\n",
    "    shutil.copy(ruta, os.path.join(\"videos\", nombre))\n",
    "    ahora = datetime.datetime.now().isoformat(timespec=\"seconds\")\n",
    "    with conectar() as con:\n",
    "        cur = con.execute(\"INSERT INTO videos (nombre_archivo, resumen) VALUES (?,?)\", (nombre, resumen))\n",
    "        con.execute(\n",
    "            \"INSERT INTO analisis_videos (video_id, fecha, duracion_seg, fps, ancho, alto, brillo_promedio, \"\n",
    "            \"cambios_escena, idioma, transcripcion, palabras_clave, miniatura) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)\",\n",
    "            (cur.lastrowid, ahora, vis[\"duracion\"], vis[\"fps\"], vis[\"ancho\"], vis[\"alto\"], vis[\"brillo\"],\n",
    "             vis[\"cambios\"], idioma, texto, claves, vis[\"miniatura\"]))\n",
    "    return {\"archivo\": nombre, \"duracion\": vis[\"duracion\"], \"resolucion\": f\"{vis['ancho']}x{vis['alto']}\",\n",
    "            \"cambios\": vis[\"cambios\"], \"brillo\": vis[\"brillo\"], \"idioma\": idioma,\n",
    "            \"palabras_clave\": claves, \"resumen\": resumen, \"miniatura\": vis[\"miniatura\"]}"
   ]
