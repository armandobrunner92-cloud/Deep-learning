    "## c. Interfaz (Gradio)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "def ui_texto(texto, producto, cliente):\n",
    "    try:\n",
    "        return procesar_texto(texto, producto, cliente)\n",
    "    except Exception as e:\n",
    "        return f\"Error: {e}\"\n",
    "\n",
    "def ui_csv(ruta):\n",
    "    if ruta is None:\n",
    "        return \"Sube un archivo .csv.\"\n",
    "    try:\n",
    "        ok, total = procesar_csv(ruta)\n",
    "    except Exception as e:\n",
    "        return f\"Error: {e}\"\n",
    "    return f\"Comentarios procesados y guardados: {ok} de {total} filas.\"\n",
    "\n",
    "def ver_tablas():\n",
    "    with conectar() as con:\n",
    "        c = pd.read_sql_query(\"SELECT * FROM comentarios ORDER BY id DESC\", con)\n",
    "        a = pd.read_sql_query(\"SELECT * FROM analisis_textos ORDER BY id DESC\", con)\n",
    "        r = pd.read_sql_query('''SELECT producto, COUNT(*) AS comentarios, SUM(likes) AS likes, SUM(dislikes) AS dislikes\n",
    "                                 FROM comentarios GROUP BY producto ORDER BY comentarios DESC''', con)\n",
    "    return c, a, r\n",
    "\n",
    "with gr.Blocks(title=\"Comentarios de productos en texto\") as demo:\n",
    "    gr.Markdown(\"# Análisis de comentarios de productos en texto\")\n",
    "    with gr.Tabs():\n",
    "        with gr.TabItem(\"Analizar comentario\"):\n",
    "            producto = gr.Textbox(label=\"Producto\")\n",
    "            cliente = gr.Textbox(label=\"Cliente\")\n",
    "            texto = gr.Textbox(label=\"Comentario\", lines=4)\n",
    "            btn = gr.Button(\"Analizar y guardar\", variant=\"primary\")\n",
    "            salida = gr.Textbox(label=\"Análisis\", lines=5)\n",
    "            btn.click(ui_texto, [texto, producto, cliente], salida)\n",
    "        with gr.TabItem(\"Analizar CSV\"):\n",
    "            gr.Markdown(\"Sube un **.csv** con las columnas `producto`, `cliente` y `comentario`.\")\n",
    "            f_in = gr.File(file_types=[\".csv\"], type=\"filepath\", label=\"Archivo CSV\")\n",
    "            f_btn = gr.Button(\"Procesar archivo\", variant=\"primary\")\n",
    "            f_out = gr.Textbox(label=\"Resultado\")\n",
    "            f_btn.click(ui_csv, f_in, f_out)\n",
    "        with gr.TabItem(\"Base de datos\"):\n",
    "            b = gr.Button(\"Actualizar tablas\")\n",
    "            t_c = gr.Dataframe(label=\"Tabla: comentarios\")\n",
    "            t_a = gr.Dataframe(label=\"Tabla: analisis_textos\")\n",
    "            t_r = gr.Dataframe(label=\"Resumen por producto\")\n",
    "            b.click(ver_tablas, None, [t_c, t_a, t_r])\n",
    "\n",
    "demo.launch(share=True, debug=True)"
   ]
