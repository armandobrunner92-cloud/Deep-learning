   "source": [
    "## b. Modelo y procesamiento de textos"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import re, datetime\n",
    "from collections import Counter\n",
    "import torch\n",
    "from transformers import pipeline\n",
    "\n",
    "dev_idx = 0 if torch.cuda.is_available() else -1\n",
    "clasificador = pipeline(\"text-classification\", model=\"cardiffnlp/twitter-xlm-roberta-base-sentiment\", device=dev_idx)\n",
    "\n",
    "MAPA = {\"positive\": \"positivo\", \"negative\": \"negativo\", \"neutral\": \"neutro\",\n",
    "        \"label_0\": \"negativo\", \"label_1\": \"neutro\", \"label_2\": \"positivo\"}\n",
    "\n",
    "def clasificar_sentimiento(texto):\n",
    "    r = clasificador(texto, truncation=True)[0]\n",
    "    etiqueta = r[\"label\"].lower()\n",
    "    return MAPA.get(etiqueta, etiqueta), float(r[\"score\"])"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "STOPWORDS = set('''de la que el en y a los del se las por un para con no una su al lo como más pero sus le ya o este\n",
    "sí porque esta entre cuando muy sin sobre también me hasta hay donde quien desde todo nos durante todos uno les ni\n",
    "contra otros ese eso ante ellos e esto mí antes algunos qué unos yo otro otras otra él tanto esa estos mucho quienes\n",
    "nada muchos cual poco ella estar estas algunas algo nosotros mi mis tú te ti tu tus es son fue era soy lo he ha han\n",
    "the and was is it to of for with this that are i my have not but you very'''.split())\n",
    "\n",
    "def estadisticas_texto(texto):\n",
    "    palabras = re.findall(r\"[a-záéíóúñü]+\", texto.lower())\n",
    "    claves = [p for p in palabras if len(p) > 3 and p not in STOPWORDS]\n",
    "    top = [p for p, _ in Counter(claves).most_common(5)]\n",
    "    return len(palabras), len(texto), \", \".join(top)\n",
    "\n",
    "def procesar_texto(texto, producto, cliente):\n",
    "    texto, producto, cliente = (texto or \"\").strip(), (producto or \"\").strip(), (cliente or \"\").strip()\n",
    "    if not producto or not cliente:\n",
    "        raise ValueError(\"Indica el producto y el cliente.\")\n",
    "    if not texto:\n",
    "        raise ValueError(\"Escribe el comentario.\")\n",
    "    sentimiento, confianza = clasificar_sentimiento(texto)\n",
    "    n_pal, n_car, claves = estadisticas_texto(texto)\n",
    "    like = 1 if sentimiento == \"positivo\" else 0\n",
    "    dislike = 1 if sentimiento == \"negativo\" else 0\n",
    "    ahora = datetime.datetime.now().isoformat(timespec=\"seconds\")\n",
    "    with conectar() as con:\n",
    "        cur = con.execute(\"INSERT INTO comentarios (producto, likes, dislikes, cliente) VALUES (?,?,?,?)\",\n",
    "                          (producto, like, dislike, cliente))\n",
    "        cid = cur.lastrowid\n",
    "        con.execute(\n",
    "            \"INSERT INTO analisis_textos (comentario_id, fecha, texto, num_palabras, num_caracteres, \"\n",
    "            \"sentimiento, confianza, palabras_clave) VALUES (?,?,?,?,?,?,?,?)\",\n",
    "            (cid, ahora, texto, n_pal, n_car, sentimiento, confianza, claves))\n",
    "    return (f\"Sentimiento: {sentimiento} ({confianza:.1%}) -> \"\n",
    "            f\"{'LIKE' if like else 'DISLIKE' if dislike else 'sin like ni dislike'}\\n\"\n",
    "            f\"Palabras: {n_pal} | Caracteres: {n_car}\\n\"\n",
    "            f\"Palabras clave: {claves or '(ninguna)'}\\n\"\n",
    "            f\"Guardado en la base de datos (comentario #{cid}).\")\n",
    "\n",
    "MAX_FILAS = 200\n",
    "\n",
    "def procesar_csv(ruta):\n",
    "    df = pd.read_csv(ruta)\n",
    "    df.columns = [str(c).strip().lower() for c in df.columns]\n",
    "    col_texto = next((c for c in (\"comentario\", \"texto\", \"text\") if c in df.columns), None)\n",
    "    if col_texto is None or \"producto\" not in df.columns or \"cliente\" not in df.columns:\n",
    "        raise ValueError(\"El CSV debe tener las columnas: producto, cliente y comentario.\")\n",
    "    filas = []\n",
    "    for _, f in df.head(MAX_FILAS).iterrows():\n",
    "        if pd.isna(f[col_texto]) or pd.isna(f[\"producto\"]) or pd.isna(f[\"cliente\"]):\n",
    "            continue\n",
    "        procesar_texto(str(f[col_texto]), str(f[\"producto\"]), str(f[\"cliente\"]))\n",
    "        filas.append(f)\n",
    "    return len(filas), len(df)"
   ]
  },
