  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Interfaz (Gradio)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "with gr.Blocks(title=\"Análisis de sentimientos\") as demo:\n",
    "    gr.Markdown(\"# Análisis de sentimientos con Transformers\")\n",
    "    modelo = gr.Dropdown(list(MODELOS), value=list(MODELOS)[0], label=\"Modelo\")\n",
    "    with gr.Tabs():\n",
    "        with gr.TabItem(\"Texto\"):\n",
    "            t_in = gr.Textbox(label=\"Escribe o pega un texto\", lines=5)\n",
    "            t_btn = gr.Button(\"Analizar\", variant=\"primary\")\n",
    "            t_lab = gr.Label(label=\"Probabilidades\", num_top_classes=5)\n",
    "            t_txt = gr.Textbox(label=\"Resultado\")\n",
    "            t_btn.click(analizar_texto, [t_in, modelo], [t_lab, t_txt])\n",
    "        with gr.TabItem(\"Archivo\"):\n",
    "            gr.Markdown(\"Sube un **.txt** (un texto por línea) o un **.csv** (columna de texto).\")\n",
    "            f_in = gr.File(file_types=[\".txt\", \".csv\"], type=\"filepath\", label=\"Archivo\")\n",
    "            f_btn = gr.Button(\"Analizar archivo\", variant=\"primary\")\n",
    "            f_res = gr.Textbox(label=\"Resumen\", lines=5)\n",
    "            f_df = gr.Dataframe(label=\"Resultados\")\n",
    "            f_out = gr.File(label=\"Descargar resultados (CSV)\")\n",
    "            f_btn.click(analizar_archivo, [f_in, modelo], [f_res, f_df, f_out])\n",
    "        with gr.TabItem(\"Información del modelo\"):\n",
    "            i_btn = gr.Button(\"Ver información\")\n",
    "            i_out = gr.Textbox(label=\"Detalles\", lines=6)\n",
    "            i_btn.click(info_modelo, modelo, i_out)\n",
    "\n",
    "demo.launch(share=True, debug=True)"
   ]
  }
