    "# Análisis de sentimientos con Transformers\n",
    "Ejecuta las celdas en orden. La GPU ayuda con archivos grandes (Entorno de ejecución > Cambiar tipo de entorno > T4), pero también funciona en CPU."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "!pip -q install gradio transformers"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Backend: modelos y funciones"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import torch, pandas as pd\n",
    "from transformers import pipeline\n",
    "\n",
    "device = 0 if torch.cuda.is_available() else -1\n",
    "\n",
    "MODELOS = {\n",
    "    \"Multilingüe 3 clases (XLM-RoBERTa)\": \"cardiffnlp/twitter-xlm-roberta-base-sentiment\",\n",
    "    \"Multilingüe 1-5 estrellas (BERT)\": \"nlptown/bert-base-multilingual-uncased-sentiment\",\n",
    "}\n",
    "MAX_FILAS = 500\n",
    "_pipes = {}\n",
    "\n",
    "def get_pipe(nombre):\n",
    "    if nombre not in _pipes:\n",
    "        _pipes[nombre] = pipeline(\"text-classification\", model=MODELOS[nombre], device=device)\n",
    "    return _pipes[nombre]\n",
    "\n",
    "def analizar_texto(texto, modelo):\n",
    "    if not texto or not texto.strip():\n",
    "        return {}, \"Escribe un texto.\"\n",
    "    res = get_pipe(modelo)(texto, top_k=None, truncation=True)\n",
    "    if res and isinstance(res[0], list):\n",
    "        res = res[0]\n",
    "    scores = {r[\"label\"]: float(r[\"score\"]) for r in res}\n",
    "    mejor = max(scores, key=scores.get)\n",
    "    return scores, f\"Predicción: {mejor} ({scores[mejor]:.1%})\"\n",
    "\n",
    "def leer_textos(ruta):\n",
    "    if ruta.lower().endswith(\".csv\"):\n",
    "        df = pd.read_csv(ruta)\n",
    "        col = next((c for c in df.columns if str(c).lower() in (\"texto\", \"text\", \"comentario\", \"review\")), None)\n",
    "        if col is None:\n",
    "            col = next((c for c in df.columns if pd.api.types.is_string_dtype(df[c])), None)\n",
    "        if col is None:\n",
    "            raise ValueError(\"El CSV no tiene una columna de texto.\")\n",
    "        return df[col].dropna().astype(str).tolist()\n",
    "    with open(ruta, encoding=\"utf-8\", errors=\"ignore\") as f:\n",
    "        return [l.strip() for l in f if l.strip()]\n",
    "\n",
    "def analizar_archivo(ruta, modelo):\n",
    "    if ruta is None:\n",
    "        return \"Sube un archivo .txt o .csv.\", None, None\n",
    "    try:\n",
    "        todos = leer_textos(ruta)\n",
    "        textos = todos[:MAX_FILAS]\n",
    "        if not textos:\n",
    "            return \"El archivo no tiene texto.\", None, None\n",
    "        res = get_pipe(modelo)(textos, batch_size=16, truncation=True)\n",
    "    except Exception as e:\n",
    "        return f\"Error: {e}\", None, None\n",
    "    df = pd.DataFrame({\n",
    "        \"texto\": textos,\n",
    "        \"sentimiento\": [r[\"label\"] for r in res],\n",
    "        \"confianza\": [round(r[\"score\"], 3) for r in res],\n",
    "    })\n",
    "    resumen = \"\\n\".join(f\"{k}: {v} ({v / len(df):.0%})\" for k, v in df[\"sentimiento\"].value_counts().items())\n",
    "    resumen = f\"Textos analizados: {len(df)}\\n\" + resumen\n",
    "    if len(todos) > MAX_FILAS:\n",
    "        resumen += f\"\\n(Se analizaron solo los primeros {MAX_FILAS} de {len(todos)} textos.)\"\n",
    "    df.to_csv(\"resultados_sentimiento.csv\", index=False)\n",
    "    return resumen, df, \"resultados_sentimiento.csv\"\n",
    "\n",
    "def info_modelo(modelo):\n",
    "    p = get_pipe(modelo)\n",
    "    params = sum(x.numel() for x in p.model.parameters())\n",
    "    return (f\"Modelo: {MODELOS[modelo]}\\n\"\n",
    "            f\"Etiquetas: {list(p.model.config.id2label.values())}\\n\"\n",
    "            f\"Parámetros: {params:,}\\n\"\n",
    "            f\"Dispositivo: {'GPU' if device == 0 else 'CPU'}\\n\"\n",
    "            f\"Límite por archivo: {MAX_FILAS} textos\")"
   ]
  },
  {
