   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## a. Base de datos y tabla de comentarios"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "DB = \"comentarios.db\"\n",
    "\n",
    "# Datos de ejemplo (producto, likes, dislikes, cliente)\n",
    "EJEMPLOS = [\n",
    "    (\"Auriculares Bluetooth X1\", 1, 0, \"Ana Pérez\"),\n",
    "    (\"Auriculares Bluetooth X1\", 0, 1, \"Luis Gómez\"),\n",
    "    (\"Licuadora Turbo 500\", 1, 0, \"María López\"),\n",
    "    (\"Licuadora Turbo 500\", 1, 0, \"Carlos Ruiz\"),\n",
    "    (\"Zapatillas Runner Pro\", 0, 1, \"Sofía Díaz\"),\n",
    "    (\"Zapatillas Runner Pro\", 1, 0, \"Jorge Silva\"),\n",
    "]\n",
    "\n",
    "def conectar():\n",
    "    return sqlite3.connect(DB)\n",
    "\n",
    "def crear_tablas():\n",
    "    with conectar() as con:\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS comentarios (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            producto TEXT NOT NULL,\n",
    "            likes INTEGER NOT NULL DEFAULT 0,\n",
    "            dislikes INTEGER NOT NULL DEFAULT 0,\n",
    "            cliente TEXT NOT NULL)''')\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS analisis_audios (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            comentario_id INTEGER REFERENCES comentarios(id),\n",
    "            archivo TEXT,\n",
    "            fecha TEXT,\n",
    "            duracion_seg REAL,\n",
    "            nivel_volumen_db REAL,\n",
    "            idioma TEXT,\n",
    "            transcripcion TEXT,\n",
    "            sentimiento TEXT,\n",
    "            confianza REAL)''')\n",
    "        if con.execute(\"SELECT COUNT(*) FROM comentarios\").fetchone()[0] == 0:\n",
    "            con.executemany(\"INSERT INTO comentarios (producto, likes, dislikes, cliente) VALUES (?,?,?,?)\", EJEMPLOS)\n",
    "\n",
    "crear_tablas()\n",
    "with conectar() as con:\n",
    "    display(pd.read_sql_query(\"SELECT * FROM comentarios\", con))"
   ]
  },
