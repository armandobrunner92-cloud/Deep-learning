    "## c. Interfaz (Gradio)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "def ui_procesar(ruta, producto, cliente):\n",
    "    if ruta is None:\n",
    "        return \"\", \"Sube o graba un audio.\"\n",
    "    try:\n",
    "        return procesar_audio(ruta, producto, cliente)\n",
    "    except Exception as e:\n",
    "        return \"\", f\"Error: {e}\"\n",
    "\n",
    "def ver_tablas():\n",
    "    with conectar() as con:\n",
    "        c = pd.read_sql_query(\"SELECT * FROM comentarios ORDER BY id DESC\", con)\n",
    "        a = pd.read_sql_query(\"SELECT * FROM analisis_audios ORDER BY id DESC\", con)\n",
    "        r = pd.read_sql_query('''SELECT producto, COUNT(*) AS comentarios, SUM(likes) AS likes, SUM(dislikes) AS dislikes\n",
    "                                 FROM comentarios GROUP BY producto ORDER BY comentarios DESC''', con)\n",
    "    return c, a, r\n",
    "\n",
    "with gr.Blocks(title=\"Comentarios de productos en audio\") as demo:\n",
    "    gr.Markdown(\"# Análisis de comentarios de productos en audio\")\n",
    "    with gr.Tabs():\n",
    "        with gr.TabItem(\"Analizar audio\"):\n",
    "            producto = gr.Textbox(label=\"Producto\")\n",
    "            cliente = gr.Textbox(label=\"Cliente\")\n",
    "            audio = gr.Audio(sources=[\"upload\", \"microphone\"], type=\"filepath\", label=\"Audio del comentario\")\n",
    "            btn = gr.Button(\"Analizar y guardar\", variant=\"primary\")\n",
    "            transc = gr.Textbox(label=\"Transcripción\", lines=4)\n",
    "            resumen = gr.Textbox(label=\"Análisis\", lines=4)\n",
    "            btn.click(ui_procesar, [audio, producto, cliente], [transc, resumen])\n",
    "        with gr.TabItem(\"Base de datos\"):\n",
    "            b = gr.Button(\"Actualizar tablas\")\n",
    "            t_c = gr.Dataframe(label=\"Tabla: comentarios\")\n",
    "            t_a = gr.Dataframe(label=\"Tabla: analisis_audios\")\n",
    "            t_r = gr.Dataframe(label=\"Resumen por producto\")\n",
    "            b.click(ver_tablas, None, [t_c, t_a, t_r])\n",
    "\n",
    "demo.launch(share=True, debug=True)"
   ]
