   "source": [
    "## b. Modelos y procesamiento de audio"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os, json, shutil, datetime\n",
    "import numpy as np\n",
    "import torch, whisper\n",
    "from transformers import pipeline\n",
    "\n",
    "dev_str = \"cuda\" if torch.cuda.is_available() else \"cpu\"\n",
    "dev_idx = 0 if dev_str == \"cuda\" else -1\n",
    "\n",
    "modelo_whisper = whisper.load_model(\"small\", device=dev_str)\n",
    "clasificador = pipeline(\"text-classification\", model=\"cardiffnlp/twitter-xlm-roberta-base-sentiment\", device=dev_idx)\n",
    "\n",
    "MAPA = {\"positive\": \"positivo\", \"negative\": \"negativo\", \"neutral\": \"neutro\",\n",
    "        \"label_0\": \"negativo\", \"label_1\": \"neutro\", \"label_2\": \"positivo\"}\n",
    "\n",
    "def transcribir_audio(ruta):\n",
    "    r = modelo_whisper.transcribe(ruta, fp16=(dev_str == \"cuda\"))\n",
    "    return r[\"text\"].strip(), r[\"language\"]\n",
    "\n",
    "def clasificar_sentimiento(texto):\n",
    "    r = clasificador(texto, truncation=True)[0]\n",
    "    etiqueta = r[\"label\"].lower()\n",
    "    return MAPA.get(etiqueta, etiqueta), float(r[\"score\"])\n",
    "\n",
    "def caracteristicas_audio(ruta):\n",
    "    audio = whisper.load_audio(ruta)          # mono, 16 kHz, valores entre -1 y 1\n",
    "    duracion = round(len(audio) / 16000, 2)\n",
    "    rms = float(np.sqrt(np.mean(audio ** 2)))\n",
    "    nivel_db = round(20 * np.log10(rms + 1e-9), 1)\n",
    "    return duracion, nivel_db\n",
    "\n",
    "os.makedirs(\"audios\", exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def procesar_audio(ruta, producto, cliente):\n",
    "    producto, cliente = (producto or \"\").strip(), (cliente or \"\").strip()\n",
    "    if not producto or not cliente:\n",
    "        raise ValueError(\"Indica el producto y el cliente.\")\n",
    "    texto, idioma = transcribir_audio(ruta)\n",
    "    if not texto:\n",
    "        raise ValueError(\"No se detectó voz en el audio.\")\n",
    "    sentimiento, confianza = clasificar_sentimiento(texto)\n",
    "    duracion, nivel_db = caracteristicas_audio(ruta)\n",
    "\n",
    "    like = 1 if sentimiento == \"positivo\" else 0\n",
    "    dislike = 1 if sentimiento == \"negativo\" else 0\n",
    "\n",
    "    ahora = datetime.datetime.now()\n",
    "    destino = os.path.join(\"audios\", f\"{ahora:%Y%m%d_%H%M%S}_{os.path.basename(ruta)}\")\n",
    "    shutil.copy(ruta, destino)\n",
    "\n",
    "    with conectar() as con:\n",
    "        cur = con.execute(\"INSERT INTO comentarios (producto, likes, dislikes, cliente) VALUES (?,?,?,?)\",\n",
    "                          (producto, like, dislike, cliente))\n",
    "        cid = cur.lastrowid\n",
    "        con.execute(\n",
    "            \"INSERT INTO analisis_audios (comentario_id, archivo, fecha, duracion_seg, nivel_volumen_db, \"\n",
    "            \"idioma, transcripcion, sentimiento, confianza) VALUES (?,?,?,?,?,?,?,?,?)\",\n",
    "            (cid, destino, ahora.isoformat(timespec=\"seconds\"), duracion, nivel_db,\n",
    "             idioma, texto, sentimiento, confianza))\n",
    "\n",
    "    resumen = (f\"Sentimiento: {sentimiento} ({confianza:.1%}) -> \"\n",
    "               f\"{'LIKE' if like else 'DISLIKE' if dislike else 'sin like ni dislike'}\\n\"\n",
    "               f\"Idioma: {idioma} | Duración: {duracion} s | Volumen: {nivel_db} dB\\n\"\n",
    "               f\"Guardado en la base de datos (comentario #{cid}).\")\n",
    "    return texto, resumen"
   ]
  },
