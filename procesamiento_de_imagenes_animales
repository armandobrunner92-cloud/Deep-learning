   "source": [
    "## c. Interfaz (Gradio)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import gradio as gr\n",
    "\n",
    "def ui_analizar(ruta):\n",
    "    if ruta is None:\n",
    "        return {}, \"Sube una fotografía.\", pd.DataFrame()\n",
    "    try:\n",
    "        r = procesar_foto(ruta)\n",
    "    except Exception as e:\n",
    "        return {}, f\"Error: {e}\", pd.DataFrame()\n",
    "    return r[\"top3\"], r[\"resumen\"], r[\"ficha\"]\n",
    "\n",
    "def ver_tablas():\n",
    "    with conectar() as con:\n",
    "        a = pd.read_sql_query(\"SELECT * FROM animales\", con)\n",
    "        f = pd.read_sql_query('''SELECT f.id, f.fecha, a.nombre_comun AS animal, f.confianza, f.ancho, f.alto,\n",
    "                                        f.formato, f.brillo, f.color_dominante, f.archivo\n",
    "                                 FROM analisis_fotos f LEFT JOIN animales a ON a.id = f.animal_id\n",
    "                                 ORDER BY f.id DESC''', con)\n",
    "    return a, f\n",
    "\n",
    "def agregar_animal(comun, en, cientifico, clase, habitat, dieta, tamano, domestico):\n",
    "    comun, en = (comun or \"\").strip(), (en or \"\").strip()\n",
    "    if not comun or not en:\n",
    "        return \"El nombre común y el nombre en inglés son obligatorios.\"\n",
    "    try:\n",
    "        with conectar() as con:\n",
    "            con.execute(\n",
    "                \"INSERT INTO animales (nombre_comun, nombre_en, nombre_cientifico, clase, habitat, dieta, tamano, domestico) \"\n",
    "                \"VALUES (?,?,?,?,?,?,?,?)\",\n",
    "                (comun, en.lower(), cientifico, clase, habitat, dieta, tamano, domestico))\n",
    "    except sqlite3.IntegrityError:\n",
    "        return \"Ese animal ya existe en la tabla.\"\n",
    "    return f\"Animal agregado: {comun}\"\n",
    "\n",
    "with gr.Blocks(title=\"Análisis de fotografías de animales\") as demo:\n",
    "    gr.Markdown(\"# Análisis de fotografías de animales\")\n",
    "    with gr.Tabs():\n",
    "        with gr.TabItem(\"Analizar foto\"):\n",
    "            foto = gr.Image(type=\"filepath\", label=\"Fotografía\")\n",
    "            btn = gr.Button(\"Analizar y guardar\", variant=\"primary\")\n",
    "            lab = gr.Label(label=\"Posibles animales\", num_top_classes=3)\n",
    "            txt = gr.Textbox(label=\"Análisis\", lines=5)\n",
    "            ficha = gr.Dataframe(label=\"Características del animal identificado\")\n",
    "            btn.click(ui_analizar, foto, [lab, txt, ficha])\n",
    "        with gr.TabItem(\"Base de datos\"):\n",
    "            b_ver = gr.Button(\"Actualizar tablas\")\n",
    "            t_an = gr.Dataframe(label=\"Tabla: animales\")\n",
    "            t_fo = gr.Dataframe(label=\"Tabla: analisis_fotos\")\n",
    "            b_ver.click(ver_tablas, None, [t_an, t_fo])\n",
    "        with gr.TabItem(\"Agregar animal\"):\n",
    "            c = gr.Textbox(label=\"Nombre común\")\n",
    "            e = gr.Textbox(label=\"Nombre en inglés (lo usa el modelo)\")\n",
    "            ci = gr.Textbox(label=\"Nombre científico\")\n",
    "            cl = gr.Textbox(label=\"Clase\")\n",
    "            ha = gr.Textbox(label=\"Hábitat\")\n",
    "            di = gr.Textbox(label=\"Dieta\")\n",
    "            ta = gr.Textbox(label=\"Tamaño\")\n",
    "            do = gr.Dropdown([\"Sí\", \"No\"], value=\"No\", label=\"Doméstico\")\n",
    "            b_add = gr.Button(\"Agregar\", variant=\"primary\")\n",
    "            msg = gr.Textbox(label=\"Resultado\")\n",
    "            b_add.click(agregar_animal, [c, e, ci, cl, ha, di, ta, do], msg)\n",
    "\n",
    "demo.launch(share=True, debug=True)"
   ]
  },
