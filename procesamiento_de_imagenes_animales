   "source": [
    "## a. Base de datos y tabla de características de animales"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import sqlite3\n",
    "import pandas as pd\n",
    "\n",
    "DB = \"animales.db\"\n",
    "\n",
    "# nombre_comun, nombre_en (lo usa el modelo), nombre_cientifico, clase, habitat, dieta, tamano, domestico\n",
    "ANIMALES = [\n",
    "    (\"Perro\", \"dog\", \"Canis lupus familiaris\", \"Mamífero\", \"Doméstico, variado\", \"Omnívoro\", \"Mediano\", \"Sí\"),\n",
    "    (\"Gato\", \"cat\", \"Felis catus\", \"Mamífero\", \"Doméstico\", \"Carnívoro\", \"Pequeño\", \"Sí\"),\n",
    "    (\"Caballo\", \"horse\", \"Equus ferus caballus\", \"Mamífero\", \"Praderas y granjas\", \"Herbívoro\", \"Grande\", \"Sí\"),\n",
    "    (\"Vaca\", \"cow\", \"Bos taurus\", \"Mamífero\", \"Pastizales y granjas\", \"Herbívoro\", \"Grande\", \"Sí\"),\n",
    "    (\"Conejo\", \"rabbit\", \"Oryctolagus cuniculus\", \"Mamífero\", \"Praderas y madrigueras\", \"Herbívoro\", \"Pequeño\", \"Sí\"),\n",
    "    (\"León\", \"lion\", \"Panthera leo\", \"Mamífero\", \"Sabana\", \"Carnívoro\", \"Grande\", \"No\"),\n",
    "    (\"Tigre\", \"tiger\", \"Panthera tigris\", \"Mamífero\", \"Bosques y selvas de Asia\", \"Carnívoro\", \"Grande\", \"No\"),\n",
    "    (\"Elefante\", \"elephant\", \"Loxodonta africana\", \"Mamífero\", \"Sabana y bosques\", \"Herbívoro\", \"Muy grande\", \"No\"),\n",
    "    (\"Jirafa\", \"giraffe\", \"Giraffa camelopardalis\", \"Mamífero\", \"Sabana\", \"Herbívoro\", \"Muy grande\", \"No\"),\n",
    "    (\"Oso pardo\", \"brown bear\", \"Ursus arctos\", \"Mamífero\", \"Bosques y montañas\", \"Omnívoro\", \"Grande\", \"No\"),\n",
    "    (\"Delfín\", \"dolphin\", \"Familia Delphinidae\", \"Mamífero\", \"Océanos\", \"Carnívoro\", \"Mediano\", \"No\"),\n",
    "    (\"Águila real\", \"eagle\", \"Aquila chrysaetos\", \"Ave\", \"Montañas y bosques\", \"Carnívoro\", \"Mediano\", \"No\"),\n",
    "    (\"Loro\", \"parrot\", \"Orden Psittaciformes\", \"Ave\", \"Selvas tropicales\", \"Herbívoro (semillas y frutos)\", \"Pequeño\", \"No\"),\n",
    "    (\"Pingüino\", \"penguin\", \"Familia Spheniscidae\", \"Ave\", \"Costas del hemisferio sur\", \"Carnívoro\", \"Mediano\", \"No\"),\n",
    "    (\"Serpiente\", \"snake\", \"Suborden Serpentes\", \"Reptil\", \"Variado\", \"Carnívoro\", \"Variable\", \"No\"),\n",
    "]\n",
    "\n",
    "def conectar():\n",
    "    return sqlite3.connect(DB)\n",
    "\n",
    "def crear_tablas():\n",
    "    with conectar() as con:\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS animales (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            nombre_comun TEXT NOT NULL,\n",
    "            nombre_en TEXT NOT NULL UNIQUE,\n",
    "            nombre_cientifico TEXT,\n",
    "            clase TEXT,\n",
    "            habitat TEXT,\n",
    "            dieta TEXT,\n",
    "            tamano TEXT,\n",
    "            domestico TEXT)''')\n",
    "        con.execute('''CREATE TABLE IF NOT EXISTS analisis_fotos (\n",
    "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
    "            archivo TEXT,\n",
    "            fecha TEXT,\n",
    "            animal_id INTEGER REFERENCES animales(id),\n",
    "            confianza REAL,\n",
    "            top3 TEXT,\n",
    "            ancho INTEGER,\n",
    "            alto INTEGER,\n",
    "            formato TEXT,\n",
    "            brillo REAL,\n",
    "            color_dominante TEXT)''')\n",
    "        if con.execute(\"SELECT COUNT(*) FROM animales\").fetchone()[0] == 0:\n",
    "            con.executemany(\n",
    "                \"INSERT INTO animales (nombre_comun, nombre_en, nombre_cientifico, clase, habitat, dieta, tamano, domestico) \"\n",
    "                \"VALUES (?,?,?,?,?,?,?,?)\", ANIMALES)\n",
    "\n",
    "crear_tablas()\n",
    "with conectar() as con:\n",
    "    display(pd.read_sql_query(\"SELECT * FROM animales\", con))"
   ]
  },
