   "source": [
    "## b. Modelo y procesamiento de fotografías"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "import os, json, shutil, datetime\n",
    "import numpy as np\n",
    "import torch\n",
    "from PIL import Image\n",
    "from transformers import pipeline\n",
    "\n",
    "device = 0 if torch.cuda.is_available() else -1\n",
    "clf = pipeline(\"zero-shot-image-classification\", model=\"openai/clip-vit-base-patch32\", device=device)\n",
    "\n",
    "UMBRAL = 0.40   # confianza mínima para asignar un animal de la tabla\n",
    "os.makedirs(\"fotos\", exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": null,
   "outputs": [],
   "source": [
    "def caracteristicas_imagen(img):\n",
    "    gris = np.asarray(img.convert(\"L\"), dtype=float)\n",
    "    brillo = round(float(gris.mean()), 1)\n",
    "    q = img.resize((64, 64)).quantize(colors=4)\n",
    "    pal = q.getpalette()\n",
    "    _, idx = max(q.getcolors())\n",
    "    r, g, b = pal[idx * 3: idx * 3 + 3]\n",
    "    return brillo, \"#{:02x}{:02x}{:02x}\".format(r, g, b)\n",
    "\n",
    "def procesar_foto(ruta):\n",
    "    original = Image.open(ruta)\n",
    "    formato = original.format or os.path.splitext(ruta)[1].lstrip(\".\").upper()\n",
    "    img = original.convert(\"RGB\")\n",
    "    ancho, alto = img.size\n",
    "    brillo, color = caracteristicas_imagen(img)\n",
    "\n",
    "    with conectar() as con:\n",
    "        animales = pd.read_sql_query(\"SELECT * FROM animales\", con)\n",
    "    nombres = dict(zip(animales[\"nombre_en\"], animales[\"nombre_comun\"]))\n",
    "    res = clf(img, candidate_labels=animales[\"nombre_en\"].tolist(),\n",
    "              hypothesis_template=\"a photo of a {}.\")\n",
    "    top3 = {nombres[r[\"label\"]]: float(r[\"score\"]) for r in res[:3]}\n",
    "    mejor = res[0]\n",
    "\n",
    "    animal_id, ficha = None, pd.DataFrame()\n",
    "    if mejor[\"score\"] >= UMBRAL:\n",
    "        fila = animales[animales[\"nombre_en\"] == mejor[\"label\"]].iloc[0]\n",
    "        animal_id = int(fila[\"id\"])\n",
    "        ficha = pd.DataFrame({\"Característica\": [\"Nombre científico\", \"Clase\", \"Hábitat\", \"Dieta\", \"Tamaño\", \"Doméstico\"],\n",
    "                              \"Valor\": [fila[\"nombre_cientifico\"], fila[\"clase\"], fila[\"habitat\"],\n",
    "                                        fila[\"dieta\"], fila[\"tamano\"], fila[\"domestico\"]]})\n",
    "        titulo = f\"Animal identificado: {fila['nombre_comun']} ({mejor['score']:.1%})\"\n",
    "    else:\n",
    "        titulo = f\"No se identificó un animal de la tabla (mejor opción: {nombres[mejor['label']]}, {mejor['score']:.1%})\"\n",
    "\n",
    "    ahora = datetime.datetime.now()\n",
    "    destino = os.path.join(\"fotos\", f\"{ahora:%Y%m%d_%H%M%S}_{os.path.basename(ruta)}\")\n",
    "    shutil.copy(ruta, destino)\n",
    "\n",
    "    with conectar() as con:\n",
    "        con.execute(\n",
    "            \"INSERT INTO analisis_fotos (archivo, fecha, animal_id, confianza, top3, ancho, alto, formato, brillo, color_dominante) \"\n",
    "            \"VALUES (?,?,?,?,?,?,?,?,?,?)\",\n",
    "            (destino, ahora.isoformat(timespec=\"seconds\"), animal_id, float(mejor[\"score\"]),\n",
    "             json.dumps(top3, ensure_ascii=False), int(ancho), int(alto), formato, brillo, color))\n",
    "\n",
    "    resumen = (f\"{titulo}\\nTamaño: {ancho}x{alto} px | Formato: {formato}\\n\"\n",
    "               f\"Brillo promedio: {brillo}/255 | Color dominante: {color}\\n\"\n",
    "               f\"Análisis guardado en la base de datos.\")\n",
    "    return {\"top3\": top3, \"resumen\": resumen, \"ficha\": ficha}"
   ]
  },
  {
